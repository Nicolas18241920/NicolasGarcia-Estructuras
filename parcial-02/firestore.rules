rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /nodes/{nodeId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'type', 'parentId', 'createdBy', 'createdAt'])
        && request.resource.data.createdBy == request.auth.token.email
        && request.resource.data.type in ['file', 'folder']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && (request.resource.data.parentId == null
            || get(/databases/$(database)/documents/nodes/$(request.resource.data.parentId)).data.type == 'folder');

      allow update: if false;
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.token.email;
    }
  }
}
